# Run at build time (cmake -P) to write vmDate.cpp, which holds the VM's
# version number, build ID and build date.
#
# The build ID identifies the VM binary: the git revision, the platform and
# the build configuration.  It is written into snapshots, and saved compiled
# code is only reused by a VM with the same build ID.  It must therefore
# differ whenever the VM could differ:
#   - uncommitted changes to the VM sources add a fingerprint of the changes;
#   - with no git revision to go on, the build time is added, so that every
#     build counts as a different VM.
# Otherwise it is stable, and rebuilding unchanged sources leaves vmDate.cpp
# alone.

# configured variables
set(PLATFORM "@platform_name@ @platform_processor@")
set(GIT_DIR "@CMAKE_CURRENT_SOURCE_DIR@/..")
set(IN_FILE "@SRC_VMDATE_IN@")
set(OUT_FILE "@SRC_VMDATE@")
set(VERSION_MAJOR "@SELF_VERSION_MAJOR@")
set(VERSION_MINOR "@SELF_VERSION_MINOR@")
if("@SELF_VERSION_IS_DEVELOPMENT@")
  set(VERSION_IS_DEVELOPMENT true)
else()
  set(VERSION_IS_DEVELOPMENT false)
endif()
set(BUILD_CONFIG "@SELF_BUILD_CONFIG_ID@")

# the parts of the tree that go into a VM
set(VM_PATHS vm vm64 VERSION CMakeLists.txt)

# make sure we don't get translated messages
set(ENV{LC_ALL} C)

string(TIMESTAMP BUILD_DATE "%Y-%m-%dT%H:%M:%SZ" UTC)

# git revision
set(REVISION)
execute_process(COMMAND git describe --always --tags
  WORKING_DIRECTORY "${GIT_DIR}"
  RESULT_VARIABLE git_result
  OUTPUT_VARIABLE REVISION
  ERROR_VARIABLE git_error
  OUTPUT_STRIP_TRAILING_WHITESPACE)

if(git_result OR NOT REVISION)
  # no git, or not a git checkout
  set(REVISION "unknown ${BUILD_DATE}")
else()
  # uncommitted changes to the VM sources
  execute_process(COMMAND git diff HEAD -- ${VM_PATHS}
    WORKING_DIRECTORY "${GIT_DIR}"
    RESULT_VARIABLE diff_result
    OUTPUT_VARIABLE DIFF
    ERROR_VARIABLE git_error)
  execute_process(COMMAND git ls-files --others --exclude-standard -- ${VM_PATHS}
    WORKING_DIRECTORY "${GIT_DIR}"
    RESULT_VARIABLE others_result
    OUTPUT_VARIABLE OTHERS
    ERROR_VARIABLE git_error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(diff_result OR others_result)
    set(REVISION "${REVISION}-dirty ${BUILD_DATE}")
  elseif(DIFF OR OTHERS)
    set(FINGERPRINT "${DIFF}\n${OTHERS}")
    string(REPLACE "\n" ";" OTHER_FILES "${OTHERS}")
    foreach(f ${OTHER_FILES})
      if(EXISTS "${GIT_DIR}/${f}" AND NOT IS_DIRECTORY "${GIT_DIR}/${f}")
        file(MD5 "${GIT_DIR}/${f}" h)
        set(FINGERPRINT "${FINGERPRINT}\n${h}")
      endif()
    endforeach()
    string(MD5 FINGERPRINT "${FINGERPRINT}")
    string(SUBSTRING "${FINGERPRINT}" 0 8 FINGERPRINT)
    set(REVISION "${REVISION}-dirty.${FINGERPRINT}")
  endif()
endif()

set(BUILD_ID "${REVISION} ${PLATFORM} ${BUILD_CONFIG}")

# Leave the file alone if it is already for this version and build ID, so
# that an unchanged VM is not relinked and keeps its build date.
set(up_to_date FALSE)
if(EXISTS "${OUT_FILE}")
  file(READ "${OUT_FILE}" existing)
  string(FIND "${existing}" "vmBuildID   = \"${BUILD_ID}\";" id_at)
  string(FIND "${existing}" "VM_major_version = ${VERSION_MAJOR};" major_at)
  string(FIND "${existing}" "VM_minor_version = ${VERSION_MINOR};" minor_at)
  string(FIND "${existing}" "VM_is_development_version = ${VERSION_IS_DEVELOPMENT};" dev_at)
  if(NOT id_at EQUAL -1 AND NOT major_at EQUAL -1 AND NOT minor_at EQUAL -1 AND NOT dev_at EQUAL -1)
    set(up_to_date TRUE)
  endif()
endif()

#set is:
# VERSION_MAJOR
# VERSION_MINOR
# VERSION_IS_DEVELOPMENT
# BUILD_ID
# BUILD_DATE

if(NOT up_to_date)
  configure_file("${IN_FILE}" "${OUT_FILE}" @ONLY)
endif()
